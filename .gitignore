# Keep the copied assignment brief local to this machine.
assignment-brief.txt

# Python virtual environment and bytecode
.venv/
__pycache__/
*.py[cod]

# Generated SQLite databases
*.sqlite
*.sqlite3
*.db

# Full-scale generated output is reproducible and stays outside GitHub.
/data/full/
/data/*full*/
/data/oryva-full*/
/full/
/full_*/
*.full.csv

# Prevent accidental submission of large local artifacts; repository tests also
# enforce a 50 MB cap because .gitignore cannot express a size predicate.
/data/**/*.sqlite3
/data/**/*.db
